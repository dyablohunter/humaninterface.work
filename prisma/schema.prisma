  LOCAL_OBSERVATION
  PHOTO_VERIFICATION
  AUDIO_TRANSCRIPTION
  DATA_LABELING
  DELIVERY_RUNNER

  // Digital / AI-fallback work
  SCREENSHOT_CAPTURE
