generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HUMAN
  AI
}

enum Urgency {
  LOW
  NORMAL
  URGENT
  CRITICAL
}

enum Privacy {
  PUBLIC
  PRIVATE
}

enum TaskType {
  MICRO
  TASK
  JOB
}

enum TaskStatus {
  PENDING_DEPOSIT
  OPEN
  PAUSED
  CANCELLING
  COMPLETED
  CANCELLED
  PURGED
  FAIRNESS_FLAGGED
}

enum SlotStatus {
  OPEN
  PENDING_DEPOSIT
  CLAIMED
  SUBMITTED
  APPROVED
  REJECTED
  DISPUTED
  RESOLVED
  PAYING
  PAID
  REFUNDING
  REFUNDED
}

enum EvidenceType {
  TEXT
  IMAGE
  VIDEO
}

/// Skill taxonomy - 116 sub-categories spanning the AI-resilient skill space.
/// See src/lib/pricing.ts for difficulty / rarity / rate calibration.
